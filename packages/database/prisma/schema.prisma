// RMSM AI — Prisma schema
// Module 002 adds the full Authentication & Authorization (IAM) data model.
// Module 001's SystemHealth infra table is preserved unchanged.
//
// Design notes:
// - Soft deletes on User (deletedAt) — users are never hard-deleted; audit
//   trails and financial/compliance history must survive account closure.
// - All tokens (refresh, password reset, email verification, recovery
//   codes) are stored as HASHES ONLY. Raw tokens are never persisted.
// - UserRole carries a nullable tenantId now so multi-tenancy (explicitly
//   scoped as a future requirement) doesn't require a breaking schema
//   migration later — it's simply unused (always null) until a Tenant
//   model is introduced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Module 001 — preserved
// ─────────────────────────────────────────────────────────────────────────

/// Infrastructure-only table used to verify the migration pipeline works.
model SystemHealth {
  id        String   @id @default(uuid())
  component String   @unique
  status    String
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// ─────────────────────────────────────────────────────────────────────────
// Module 002 — Authentication & Authorization
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  /// Added in Module 003: user-initiated or compliance-driven account
  /// archival, distinct from DELETED (soft delete). Archived accounts are
  /// not deleted — they can be restored — but are excluded from active-user
  /// listings and cannot log in until restored.
  ARCHIVED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  /// Nullable: OAuth-only users may never set a password.
  passwordHash        String?
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — accounts are deactivated, never hard-removed.
  deletedAt DateTime?

  profile            Profile?
  userRoles          UserRole[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  twoFactorSecret    TwoFactorSecret?
  recoveryCodes      RecoveryCode[]
  auditLogs          AuditLog[]
  oauthAccounts      OAuthAccount[]

  // ── Module 003 additions ──────────────────────────────────────────────
  organizationMemberships  OrganizationMembership[]
  sentInvitations          OrganizationInvitation[] @relation("InvitationSender")
  createdOrganizations     Organization[]           @relation("OrganizationCreatedBy")
  updatedOrganizations     Organization[]           @relation("OrganizationUpdatedBy")
  membershipEventsAsSubject OrganizationMembershipEvent[] @relation("MembershipEventSubject")
  membershipEventsAsActor   OrganizationMembershipEvent[] @relation("MembershipEventActor")

  @@index([status])
  @@map("users")
}

model Profile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  firstName               String?
  lastName                String?
  avatarUrl               String?
  timezone                String   @default("UTC")
  language                String   @default("en")
  phone                   String?
  /// Free-form JSON: { email: bool, push: bool, sms: bool, marketing: bool }
  notificationPreferences Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // ── Module 003 additions (all additive — nullable or defaulted, so no
  // existing Module 002 row or caller breaks) ─────────────────────────────
  /// BCP-47 locale, e.g. "en-US" — distinct from `language` (Module 002's
  /// simple UI-language code); locale additionally governs number/date
  /// formatting. Kept as a separate field rather than overloading
  /// `language` to avoid a breaking change to that column's meaning.
  locale                  String?
  /// ISO 3166-1 alpha-2 country code.
  country                 String?
  theme                   String   @default("system")
  /// Free-form JSON, shape owned by apps/web (e.g. widget positions/sizes).
  dashboardLayout         Json?
  /// The organization shown by default on login. Nullable — a user with no
  /// organizations, or who hasn't picked a default, has none. Intentionally
  /// NOT a required relation: Profile must remain creatable before a user
  /// has joined any organization (registration in Module 002 creates an
  /// empty Profile immediately).
  defaultOrganizationId   String?
  /// { twoFactorReminders: bool, loginAlerts: bool, ... } — presentation-
  /// layer preferences only; the actual security *enforcement* (lockout
  /// thresholds, password policy) stays owned by Module 002's AuthService
  /// and is not duplicated here.
  securityPreferences     Json     @default("{}")
  tradingPreferences      Json     @default("{}")
  /// { reducedMotion: bool, highContrast: bool, screenReaderOptimized: bool }
  accessibilityPreferences Json    @default("{}")

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultOrganization Organization? @relation("ProfileDefaultOrganization", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)

  @@index([defaultOrganizationId])
  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  /// System roles (seeded defaults) cannot be deleted via the API.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  /// Dotted key, e.g. "users.read", "signals.write". Application code
  /// references permissions by key, never by id.
  key         String   @unique
  description String?
  /// Groups permissions for admin UI display, e.g. "users", "billing".
  group       String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  /// Reserved for future multi-tenancy. Always null until a Tenant model
  /// exists — present now to avoid a breaking migration later.
  tenantId   String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  /// SHA-256 hash of the raw refresh token. Raw value is never stored.
  tokenHash         String    @unique
  /// Rotation family id — shared across a token's rotation chain so reuse
  /// of a revoked token can be detected and the whole family revoked.
  family            String
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_history")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model TwoFactorSecret {
  id         String    @id @default(uuid())
  userId     String    @unique
  /// Encrypted at rest by the application layer before write (see
  /// TwoFactorService) — never stored as plaintext.
  secretEnc  String
  enabled    Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════
// Module 003 — User & Organization Management
//
// Design note: Organization roles (OWNER/ADMINISTRATOR/MANAGER/ANALYST/
// TRADER/VIEWER) are intentionally NOT the same thing as Module 002's
// platform-wide Role/Permission tables. Module 002's RBAC answers "what can
// this user do on the platform" (e.g. can they access the admin portal).
// OrganizationMembership.role answers "what can this user do inside THIS
// organization" — a scoped, per-workspace question. Conflating the two
// would mean every organization needs its own copies of platform roles, or
// every platform role needs organization-awareness bolted on — both worse
// than keeping them as separate, composable concerns. A user's *effective*
// permission for an action is the intersection of both systems, resolved
// by the Phase 4 OrganizationRoleGuard, not by this schema.
// ═════════════════════════════════════════════════════════════════════════

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
  /// Soft delete — see Organization.deletedAt below for the timestamp.
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  ANALYST
  TRADER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  /// Member-initiated departure.
  /// Phase 2 amendment: neither LEFT nor REMOVED delete the membership row.
  /// "Preserve membership history" (Phase 2 constraint) means the row
  /// persists as the durable record of that user's relationship with the
  /// organization; rejoining reactivates the same row rather than creating
  /// a new one, keeping the [organizationId, userId] unique constraint
  /// intact. The original Phase 1 comment describing REMOVED as row
  /// deletion is superseded by this.
  LEFT
  /// Admin-initiated removal. See LEFT's comment — this does not delete
  /// the row either, as of the Phase 2 amendment.
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  logoUrl     String?
  description String?
  timezone    String             @default("UTC")
  currency    String             @default("USD")
  country     String?
  website     String?
  /// Free-form JSON for org-level settings (branding, default permissions,
  /// workspace preferences) — kept as JSON rather than dozens of nullable
  /// columns since this set is expected to grow across future modules
  /// (Billing, Notifications) without needing a schema migration each time.
  settings    Json               @default("{}")
  status      OrganizationStatus @default(ACTIVE)

  /// Reserved for the future Subscription/Billing module (e.g. a Stripe
  /// customer id). Not read or written by any Module 003 code — present
  /// now so Billing doesn't need a migration just to attach itself to an
  /// existing organization. Nullable and unenforced.
  billingCustomerId String? @unique
  /// Reserved for seat-based billing enforcement. Not enforced anywhere in
  /// Module 003 — membership counts are not checked against this today.
  seatsLimit        Int?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete — set alongside status = DELETED. Archival (status =
  /// ARCHIVED) does NOT set this; only hard-delete-equivalent does.
  deletedAt   DateTime?

  createdBy               User?                     @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                     @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships              OrganizationMembership[]
  invitations              OrganizationInvitation[]
  membershipEvents         OrganizationMembershipEvent[]
  profilesDefaultingHere   Profile[]                 @relation("ProfileDefaultOrganization")

  @@index([status])
  @@index([slug])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user has exactly one membership row per organization — role changes
  // and suspensions update this row rather than creating new ones.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  /// SHA-256 hash of the invitation token — same pattern as Module 002's
  /// PasswordReset/EmailVerification tokens. Raw value is emailed once,
  /// never persisted.
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 amendment — membership history (constraint: "preserve membership
// history"). Distinct from Module 002's AuditLog: AuditLog is a
// platform-wide security/compliance trail; this is a domain-specific,
// product-facing timeline ("member since", role-change history) that
// Phase 3 services and later UI will query differently (e.g. "show the
// membership timeline for organization X"), justifying its own table
// rather than overloading AuditLog's generic shape.
// ─────────────────────────────────────────────────────────────────────────

enum MembershipEventAction {
  INVITED
  INVITATION_ACCEPTED
  JOINED
  ROLE_CHANGED
  SUSPENDED
  REACTIVATED
  LEFT
  REMOVED
  OWNERSHIP_TRANSFERRED
}

model OrganizationMembershipEvent {
  id             String                @id @default(uuid())
  organizationId String
  /// Nullable + SetNull, matching Module 002's LoginHistory/AuditLog
  /// precedent: the event record outlives the user row in the rare case of
  /// a hard delete (this module only soft-deletes, but the FK shouldn't
  /// assume every future caller respects that).
  userId         String?
  action         MembershipEventAction
  previousRole   OrganizationRole?
  newRole        OrganizationRole?
  /// Who performed the action (may differ from `userId`, e.g. an admin
  /// removing another member). Null means system-initiated.
  actorId        String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("MembershipEventSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor        User?        @relation("MembershipEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("organization_membership_events")
}
