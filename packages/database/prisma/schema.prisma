// RMSM AI — Prisma schema
// Module 002 adds the full Authentication & Authorization (IAM) data model.
// Module 001's SystemHealth infra table is preserved unchanged.
//
// Design notes:
// - Soft deletes on User (deletedAt) — users are never hard-deleted; audit
//   trails and financial/compliance history must survive account closure.
// - All tokens (refresh, password reset, email verification, recovery
//   codes) are stored as HASHES ONLY. Raw tokens are never persisted.
// - UserRole carries a nullable tenantId now so multi-tenancy (explicitly
//   scoped as a future requirement) doesn't require a breaking schema
//   migration later — it's simply unused (always null) until a Tenant
//   model is introduced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Module 001 — preserved
// ─────────────────────────────────────────────────────────────────────────

/// Infrastructure-only table used to verify the migration pipeline works.
model SystemHealth {
  id        String   @id @default(uuid())
  component String   @unique
  status    String
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// ─────────────────────────────────────────────────────────────────────────
// Module 002 — Authentication & Authorization
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  /// Added in Module 003: user-initiated or compliance-driven account
  /// archival, distinct from DELETED (soft delete). Archived accounts are
  /// not deleted — they can be restored — but are excluded from active-user
  /// listings and cannot log in until restored.
  ARCHIVED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  /// Nullable: OAuth-only users may never set a password.
  passwordHash        String?
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — accounts are deactivated, never hard-removed.
  deletedAt DateTime?

  profile            Profile?
  userRoles          UserRole[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  twoFactorSecret    TwoFactorSecret?
  recoveryCodes      RecoveryCode[]
  auditLogs          AuditLog[]
  oauthAccounts      OAuthAccount[]

  // ── Module 003 additions ──────────────────────────────────────────────
  organizationMemberships  OrganizationMembership[]
  sentInvitations          OrganizationInvitation[] @relation("InvitationSender")
  createdOrganizations     Organization[]           @relation("OrganizationCreatedBy")
  updatedOrganizations     Organization[]           @relation("OrganizationUpdatedBy")
  membershipEventsAsSubject OrganizationMembershipEvent[] @relation("MembershipEventSubject")
  membershipEventsAsActor   OrganizationMembershipEvent[] @relation("MembershipEventActor")

  // ── Module 005 additions ──────────────────────────────────────────────
  notificationsReceived   Notification[]            @relation("NotificationRecipient")
  notificationLogsActedOn NotificationLog[]          @relation("NotificationLogActor")
  notificationPreferences NotificationPreference[]
  notificationDigests     NotificationDigest[]
  deviceTokens            DeviceToken[]

  // ── AI-103 additions (Milestone 2) ──────────────────────────────────
  strategiesCreated             Strategy[]             @relation("StrategyCreatedBy")
  strategiesUpdated             Strategy[]             @relation("StrategyUpdatedBy")
  strategyVersionsCreated       StrategyVersion[]      @relation("StrategyVersionCreatedBy")
  strategyVersionsUpdated       StrategyVersion[]      @relation("StrategyVersionUpdatedBy")
  ruleGroupsCreated              RuleGroup[]            @relation("RuleGroupCreatedBy")
  ruleGroupsUpdated              RuleGroup[]            @relation("RuleGroupUpdatedBy")
  rulesCreated                   Rule[]                 @relation("RuleCreatedBy")
  rulesUpdated                   Rule[]                 @relation("RuleUpdatedBy")
  conditionsCreated              Condition[]            @relation("ConditionCreatedBy")
  conditionsUpdated              Condition[]            @relation("ConditionUpdatedBy")
  strategyParametersCreated      StrategyParameter[]    @relation("StrategyParameterCreatedBy")
  strategyParametersUpdated      StrategyParameter[]    @relation("StrategyParameterUpdatedBy")
  executionProfilesCreated       ExecutionProfile[]     @relation("ExecutionProfileCreatedBy")
  executionProfilesUpdated       ExecutionProfile[]     @relation("ExecutionProfileUpdatedBy")
  strategyValidationsCreated     StrategyValidation[]   @relation("StrategyValidationCreatedBy")
  strategyApprovalsRequested     StrategyApproval[]     @relation("StrategyApprovalRequestedBy")
  strategyApprovalsDecided       StrategyApproval[]     @relation("StrategyApprovalDecidedBy")
  strategyPublicationsPublished  StrategyPublication[]  @relation("StrategyPublicationPublishedBy")
  strategyHistoryActedOn         StrategyHistory[]      @relation("StrategyHistoryActor")

  @@index([status])
  @@map("users")
}

model Profile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  firstName               String?
  lastName                String?
  avatarUrl               String?
  timezone                String   @default("UTC")
  language                String   @default("en")
  phone                   String?
  /// Free-form JSON: { email: bool, push: bool, sms: bool, marketing: bool }
  notificationPreferences Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // ── Module 003 additions (all additive — nullable or defaulted, so no
  // existing Module 002 row or caller breaks) ─────────────────────────────
  /// BCP-47 locale, e.g. "en-US" — distinct from `language` (Module 002's
  /// simple UI-language code); locale additionally governs number/date
  /// formatting. Kept as a separate field rather than overloading
  /// `language` to avoid a breaking change to that column's meaning.
  locale                  String?
  /// ISO 3166-1 alpha-2 country code.
  country                 String?
  theme                   String   @default("system")
  /// Free-form JSON, shape owned by apps/web (e.g. widget positions/sizes).
  dashboardLayout         Json?
  /// The organization shown by default on login. Nullable — a user with no
  /// organizations, or who hasn't picked a default, has none. Intentionally
  /// NOT a required relation: Profile must remain creatable before a user
  /// has joined any organization (registration in Module 002 creates an
  /// empty Profile immediately).
  defaultOrganizationId   String?
  /// { twoFactorReminders: bool, loginAlerts: bool, ... } — presentation-
  /// layer preferences only; the actual security *enforcement* (lockout
  /// thresholds, password policy) stays owned by Module 002's AuthService
  /// and is not duplicated here.
  securityPreferences     Json     @default("{}")
  tradingPreferences      Json     @default("{}")
  /// { reducedMotion: bool, highContrast: bool, screenReaderOptimized: bool }
  accessibilityPreferences Json    @default("{}")

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultOrganization Organization? @relation("ProfileDefaultOrganization", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)

  @@index([defaultOrganizationId])
  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  /// System roles (seeded defaults) cannot be deleted via the API.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  /// Dotted key, e.g. "users.read", "signals.write". Application code
  /// references permissions by key, never by id.
  key         String   @unique
  description String?
  /// Groups permissions for admin UI display, e.g. "users", "billing".
  group       String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  /// Reserved for future multi-tenancy. Always null until a Tenant model
  /// exists — present now to avoid a breaking migration later.
  tenantId   String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String
  /// SHA-256 hash of the raw refresh token. Raw value is never stored.
  tokenHash         String    @unique
  /// Rotation family id — shared across a token's rotation chain so reuse
  /// of a revoked token can be detected and the whole family revoked.
  family            String
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_history")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model TwoFactorSecret {
  id         String    @id @default(uuid())
  userId     String    @unique
  /// Encrypted at rest by the application layer before write (see
  /// TwoFactorService) — never stored as plaintext.
  secretEnc  String
  enabled    Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════
// Module 003 — User & Organization Management
//
// Design note: Organization roles (OWNER/ADMINISTRATOR/MANAGER/ANALYST/
// TRADER/VIEWER) are intentionally NOT the same thing as Module 002's
// platform-wide Role/Permission tables. Module 002's RBAC answers "what can
// this user do on the platform" (e.g. can they access the admin portal).
// OrganizationMembership.role answers "what can this user do inside THIS
// organization" — a scoped, per-workspace question. Conflating the two
// would mean every organization needs its own copies of platform roles, or
// every platform role needs organization-awareness bolted on — both worse
// than keeping them as separate, composable concerns. A user's *effective*
// permission for an action is the intersection of both systems, resolved
// by the Phase 4 OrganizationRoleGuard, not by this schema.
// ═════════════════════════════════════════════════════════════════════════

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
  /// Soft delete — see Organization.deletedAt below for the timestamp.
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  ANALYST
  TRADER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  /// Member-initiated departure.
  /// Phase 2 amendment: neither LEFT nor REMOVED delete the membership row.
  /// "Preserve membership history" (Phase 2 constraint) means the row
  /// persists as the durable record of that user's relationship with the
  /// organization; rejoining reactivates the same row rather than creating
  /// a new one, keeping the [organizationId, userId] unique constraint
  /// intact. The original Phase 1 comment describing REMOVED as row
  /// deletion is superseded by this.
  LEFT
  /// Admin-initiated removal. See LEFT's comment — this does not delete
  /// the row either, as of the Phase 2 amendment.
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  logoUrl     String?
  description String?
  timezone    String             @default("UTC")
  currency    String             @default("USD")
  country     String?
  website     String?
  /// Free-form JSON for org-level settings (branding, default permissions,
  /// workspace preferences) — kept as JSON rather than dozens of nullable
  /// columns since this set is expected to grow across future modules
  /// (Billing, Notifications) without needing a schema migration each time.
  settings    Json               @default("{}")
  status      OrganizationStatus @default(ACTIVE)

  /// Reserved for the future Subscription/Billing module (e.g. a Stripe
  /// customer id). Not read or written by any Module 003 code — present
  /// now so Billing doesn't need a migration just to attach itself to an
  /// existing organization. Nullable and unenforced.
  billingCustomerId String? @unique
  /// Reserved for seat-based billing enforcement. Not enforced anywhere in
  /// Module 003 — membership counts are not checked against this today.
  seatsLimit        Int?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete — set alongside status = DELETED. Archival (status =
  /// ARCHIVED) does NOT set this; only hard-delete-equivalent does.
  deletedAt   DateTime?

  createdBy               User?                     @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                     @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships              OrganizationMembership[]
  invitations              OrganizationInvitation[]
  membershipEvents         OrganizationMembershipEvent[]
  profilesDefaultingHere   Profile[]                 @relation("ProfileDefaultOrganization")

  // ── AI-103 additions (Milestone 2) ──────────────────────────────────
  strategies              Strategy[]
  strategyVersions        StrategyVersion[]
  ruleGroups              RuleGroup[]
  rules                   Rule[]
  conditions              Condition[]
  strategyParameters      StrategyParameter[]
  executionProfiles       ExecutionProfile[]
  strategyValidations     StrategyValidation[]
  strategyApprovals       StrategyApproval[]
  strategyPublications    StrategyPublication[]
  strategyHistoryEntries  StrategyHistory[]

  // ── Module 004 additions ──────────────────────────────────────────────
  subscription      OrganizationSubscription?
  billingAccount    BillingAccount?
  invoices          Invoice[]
  payments          Payment[]
  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  usageRecords      UsageRecord[]

  // ── Module 005 additions ──────────────────────────────────────────────
  notificationCategories NotificationCategory[]
  emailProviders         EmailProvider[]
  smsProviders           SmsProvider[]
  pushProviders          PushProvider[]
  notificationTemplates  NotificationTemplate[]
  notifications          Notification[]
  notificationLogs       NotificationLog[]
  notificationSchedules  NotificationSchedule[]
  notificationDigests    NotificationDigest[]
  notificationPreferences NotificationPreference[]
  deviceTokens           DeviceToken[]
  notificationWebhooks   NotificationWebhook[]

  @@index([status])
  @@index([slug])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user has exactly one membership row per organization — role changes
  // and suspensions update this row rather than creating new ones.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole
  /// SHA-256 hash of the invitation token — same pattern as Module 002's
  /// PasswordReset/EmailVerification tokens. Raw value is emailed once,
  /// never persisted.
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 amendment — membership history (constraint: "preserve membership
// history"). Distinct from Module 002's AuditLog: AuditLog is a
// platform-wide security/compliance trail; this is a domain-specific,
// product-facing timeline ("member since", role-change history) that
// Phase 3 services and later UI will query differently (e.g. "show the
// membership timeline for organization X"), justifying its own table
// rather than overloading AuditLog's generic shape.
// ─────────────────────────────────────────────────────────────────────────

enum MembershipEventAction {
  INVITED
  INVITATION_ACCEPTED
  JOINED
  ROLE_CHANGED
  SUSPENDED
  REACTIVATED
  LEFT
  REMOVED
  OWNERSHIP_TRANSFERRED
}

model OrganizationMembershipEvent {
  id             String                @id @default(uuid())
  organizationId String
  /// Nullable + SetNull, matching Module 002's LoginHistory/AuditLog
  /// precedent: the event record outlives the user row in the rare case of
  /// a hard delete (this module only soft-deletes, but the FK shouldn't
  /// assume every future caller respects that).
  userId         String?
  action         MembershipEventAction
  previousRole   OrganizationRole?
  newRole        OrganizationRole?
  /// Who performed the action (may differ from `userId`, e.g. an admin
  /// removing another member). Null means system-initiated.
  actorId        String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("MembershipEventSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor        User?        @relation("MembershipEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("organization_membership_events")
}

// ═════════════════════════════════════════════════════════════════════════
// Module 004 — Billing & Subscription Management
//
// Integration point: every model here is organization-scoped
// (organizationId FK), consistent with ADR-001 ("Organization is the
// tenant boundary"). No user-level billing exists — a user's billing
// relationship with the platform is always mediated through the
// organization(s) they belong to, matching how Module 003 already scopes
// everything else.
// ═════════════════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
  INCOMPLETE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  FAILED
}

/// Explicitly includes providers beyond the two implemented in Phase 3
/// (STRIPE, MOCK) — RAZORPAY/PADDLE/LEMONSQUEEZY are named in the prompt's
/// "Future" list. Adding the enum values now costs nothing and lets the
/// provider-abstraction interface (Phase 1, see below) reference the full
/// intended vocabulary; implementing those providers is explicitly
/// deferred, not implied by their presence here.
enum PaymentProviderType {
  STRIPE
  MOCK
  RAZORPAY
  PADDLE
  LEMONSQUEEZY
  /// Added Phase 3, per explicit instruction — not in the original prompt's
  /// "Future" provider list (Razorpay/Paddle/LemonSqueezy), but PayPal is
  /// implemented this phase alongside Razorpay.
  PAYPAL
}

/// Not one of the prompt's 5 explicitly-named enums — needed because
/// Payments requires a method type per the spec's "Method: Card, UPI,
/// Bank, Wallet" line. Flagged as an addition beyond the explicit list,
/// same discipline as every other schema-gap decision in this project.
enum PaymentMethod {
  CARD
  UPI
  BANK
  WALLET
}

/// Addition beyond the explicit enum list — Coupons requires distinguishing
/// percentage vs fixed-amount discounts per the spec.
enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Addition beyond the explicit enum list — FeatureFlag/PlanFeature need to
/// distinguish a simple on/off capability from one with a numeric cap.
enum FeatureType {
  BOOLEAN
  LIMIT
}

/// Addition beyond the explicit enum list — needed for PaymentWebhook's
/// idempotent processing state machine (Section 11: "webhook verification").
enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  /// Stable machine key, e.g. "free", "professional" — application code
  /// and the future admin UI reference plans by this, never by id, so
  /// seed data can be re-run idempotently (same pattern as Module 002's
  /// Role.name).
  key             String   @unique
  name            String
  description     String?
  /// Cents, matching Stripe's and most providers' native unit — avoids
  /// floating-point currency bugs entirely.
  monthlyPriceCents Int
  yearlyPriceCents  Int
  currency        String   @default("USD")
  trialDays       Int      @default(0)
  gracePeriodDays Int      @default(0)
  isVisible       Boolean  @default(true)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  planFeatures  PlanFeature[]
  subscriptions OrganizationSubscription[]

  @@index([isActive, isVisible])
  @@map("subscription_plans")
}

model FeatureFlag {
  id          String      @id @default(uuid())
  /// e.g. "organizations", "users", "ai_requests", "storage" — the keys
  /// named in the spec's Feature Flags section.
  key         String      @unique
  name        String
  description String?
  type        FeatureType
  createdAt   DateTime    @default(now())

  planFeatures PlanFeature[]

  @@map("feature_flags")
}

model PlanFeature {
  id            String  @id @default(uuid())
  planId        String
  featureFlagId String
  enabled       Boolean @default(true)
  /// Null = unlimited. Only meaningful when the parent FeatureFlag.type is
  /// LIMIT; ignored (should stay null) for BOOLEAN features — enforced by
  /// QuotaService (Phase 3), not by the schema, since Prisma has no
  /// conditional-field-based check constraint support.
  limit         Int?

  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag      @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([planId, featureFlagId])
  @@map("plan_features")
}

model OrganizationSubscription {
  id                    String             @id @default(uuid())
  /// Unique, not just indexed — "each organization owns exactly one
  /// subscription" (spec, verbatim) is a hard 1:1, enforced at the
  /// database level, not just assumed by application code.
  organizationId        String             @unique
  planId                String
  status                SubscriptionStatus @default(TRIALING)
  paymentProvider       PaymentProviderType @default(MOCK)
  /// The subscription id on the provider's side (e.g. Stripe subscription
  /// id). Null until the provider integration actually creates one —
  /// MOCK-provider subscriptions may never populate this.
  providerSubscriptionId String?
  billingCycle          BillingCycle       @default(MONTHLY)
  startDate             DateTime           @default(now())
  renewalDate           DateTime?
  cancellationDate      DateTime?
  trialEndsAt           DateTime?
  gracePeriodEndsAt     DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([status])
  @@index([planId])
  @@map("organization_subscriptions")
}

model BillingAccount {
  id             String   @id @default(uuid())
  organizationId String   @unique
  billingEmail   String
  companyName    String?
  /// GST/VAT/Tax ID — one field for whichever tax-identifier scheme the
  /// organization's country uses, per the spec listing "GST/VAT Number"
  /// and "Tax ID" together rather than as clearly distinct fields.
  taxId          String?
  /// { line1, line2?, city, state?, postalCode, } — JSON rather than
  /// discrete columns since address shape varies significantly by
  /// country and this project has no immediate need to query into
  /// individual address fields.
  address        Json     @default("{}")
  country        String
  currency       String   @default("USD")
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_accounts")
}

model Invoice {
  id             String        @id @default(uuid())
  /// Human-facing sequential/formatted number (e.g. "INV-2026-000123"),
  /// distinct from `id` — generated by InvoiceService (Phase 3), not the
  /// database, since numbering schemes are a business decision.
  invoiceNumber  String        @unique
  organizationId String
  subscriptionId String?
  subtotalCents  Int
  taxCents       Int           @default(0)
  discountCents  Int           @default(0)
  totalCents     Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  paymentDate    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  couponRedemptions CouponRedemption[]

  @@index([organizationId, status])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  description    String
  quantity       Int      @default(1)
  unitAmountCents Int
  amountCents    Int
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id                   String              @id @default(uuid())
  organizationId       String
  invoiceId            String?
  provider             PaymentProviderType
  /// Unique per provider — a transaction id from Stripe and one from a
  /// (hypothetical) Razorpay payment could theoretically collide as bare
  /// strings, so uniqueness is scoped to [provider, providerTransactionId]
  /// rather than the field alone.
  providerTransactionId String?
  amountCents          Int
  currency             String              @default("USD")
  status               PaymentStatus       @default(PENDING)
  method               PaymentMethod?
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([organizationId, status])
  @@map("payments")
}

model Coupon {
  id                String     @id @default(uuid())
  code              String     @unique
  type              CouponType
  /// Percentage: 1-100. Fixed amount: cents. Interpretation depends on
  /// `type` — enforced by CouponService (Phase 3), not the schema.
  value             Int
  currency          String?
  expiresAt         DateTime?
  maxRedemptions    Int?
  currentRedemptions Int       @default(0)
  /// Null = public coupon, usable by any organization. Non-null =
  /// restricted to that one organization.
  organizationId    String?
  isPublic          Boolean    @default(true)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions  CouponRedemption[]

  @@index([isActive, isPublic])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  organizationId String
  invoiceId      String?
  redeemedAt     DateTime @default(now())

  coupon       Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// One redemption per (coupon, organization) — an org can't stack the
  /// same coupon twice. Not stated explicitly in the spec; a defensible
  /// default, flagged here rather than silently assumed.
  @@unique([couponId, organizationId])
  @@map("coupon_redemptions")
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  /// First-of-month date, e.g. 2026-07-01 — truncated to month so a
  /// single row accumulates the whole billing period's usage for one
  /// metric, rather than one row per event (aggregated by UsageService,
  /// Phase 3, not per-call).
  period         DateTime
  /// e.g. "api_calls", "storage_bytes", "ai_tokens" — matches the metrics
  /// named in the spec's Usage Tracking section. String, not an enum,
  /// since new trackable metrics (Indicators, Strategies, Signals...) are
  /// expected to grow across future modules without a migration each time.
  metric         String
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, metric])
  @@index([organizationId, period])
  @@map("usage_records")
}

model PaymentWebhook {
  id               String                  @id @default(uuid())
  provider         PaymentProviderType
  eventType        String
  /// The provider's own event id — the idempotency key.
  /// WebhookService (Phase 3) checks this before processing so a
  /// provider's at-least-once delivery retry never double-applies an
  /// event (e.g. crediting a payment twice).
  providerEventId  String                  @unique
  payload          Json
  status           WebhookProcessingStatus @default(PENDING)
  processedAt      DateTime?
  createdAt        DateTime                @default(now())

  @@index([provider, eventType])
  @@index([status])
  @@map("payment_webhooks")
}

// ═════════════════════════════════════════════════════════════════════════
// Module 005 — Notifications & Communication Platform
//
// Design note (flagged, not silently decided): the prompt's model list
// includes NotificationChannel, NotificationStatus, NotificationPriority,
// and NotificationType alongside genuine entities (Notification,
// NotificationTemplate, etc.). Those four describe classification/state,
// not things with their own id/lifecycle/relations — modeled as enums,
// consistent with how every prior module in this project has resolved
// this exact ambiguity (Module 004's Phase 1 did the same for
// SubscriptionStatus/BillingCycle/etc.). The other 16 are real models.
//
// Tenant isolation: every model carries organizationId except where a
// null value has a specific, documented meaning (e.g. a null
// organizationId on NotificationTemplate/EmailProvider/etc. means
// "platform-wide default," not "ungoverned data") — matching ADR-001
// (Organization is the tenant boundary) and ADR-011's precedent
// (Module 004's billing models are all organization-scoped).
// ═════════════════════════════════════════════════════════════════════════

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  READ
  ARCHIVED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// How a Notification's recipients are resolved — direct, broadcast,
/// role-targeted, permission-targeted, topic-based, or a generated digest.
enum NotificationType {
  DIRECT
  BROADCAST
  ROLE
  PERMISSION
  TOPIC
  DIGEST
}

enum EmailProviderType {
  SMTP
  SES
  SENDGRID
  MAILGUN
  RESEND
}

enum SmsProviderType {
  TWILIO
  MESSAGEBIRD
  VONAGE
  AWS_SNS
}

enum PushProviderType {
  FCM
  APNS
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  OPENED
  CLICKED
}

enum ScheduleFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM_CRON
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum TemplateFormat {
  HTML
  TEXT
  MARKDOWN
}

// ─────────────────────────────────────────────────────────────────────────
// Configuration & Classification
// ─────────────────────────────────────────────────────────────────────────

model NotificationCategory {
  id             String   @id @default(uuid())
  /// Null = platform-wide category (e.g. "security"). Non-null = an
  /// organization's own custom category (e.g. "trading-signals" defined
  /// per-org for a future Strategy Builder module to notify through).
  organizationId String?
  key            String
  name           String
  description    String?
  defaultChannel NotificationChannel @default(IN_APP)
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates     NotificationTemplate[]
  notifications Notification[]
  preferences   NotificationPreference[]

  /// A category key is unique within its scope — platform-wide categories
  /// (organizationId null) share one namespace; each organization has its
  /// own. Prisma cannot express "unique per nullable scope" directly as a
  /// single constraint the way a non-nullable FK could, but the
  /// (organizationId, key) compound unique below correctly enforces this:
  /// Postgres treats every NULL organizationId as distinct from every
  /// other NULL for uniqueness purposes, which is wrong for the
  /// "platform-wide keys must still be unique among themselves" case.
  /// Flagged as a known follow-up (mirrors ADR-004's precedent): true
  /// enforcement of "unique key among all organizationId=NULL rows" needs
  /// a partial unique index, hand-written SQL, same as Decision 1's
  /// single-active-owner constraint in Module 003. Not fixed in schema.prisma
  /// itself — Phase 2's repository layer must additionally check
  /// uniqueness in application code for the organizationId=NULL case until
  /// that partial index exists.
  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@map("notification_categories")
}

model EmailProvider {
  id             String            @id @default(uuid())
  /// Null = platform default provider, used when an organization hasn't
  /// configured its own.
  organizationId String?
  type           EmailProviderType
  name           String
  /// AES-256-GCM encrypted credential blob (API keys, SMTP passwords,
  /// etc.) — same encryption approach as Module 002's TwoFactorSecret,
  /// never stored plaintext. Application-layer responsibility (Phase 2's
  /// EmailService), the schema only constrains the column to hold the
  /// encrypted form.
  credentialsEnc String
  fromAddress    String
  fromName       String?
  isActive       Boolean           @default(true)
  isDefault      Boolean           @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId, isActive])
  @@map("email_providers")
}

model SmsProvider {
  id             String          @id @default(uuid())
  organizationId String?
  type           SmsProviderType
  name           String
  credentialsEnc String
  fromNumber     String
  isActive       Boolean         @default(true)
  isDefault      Boolean         @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId, isActive])
  @@map("sms_providers")
}

model PushProvider {
  id             String           @id @default(uuid())
  organizationId String?
  type           PushProviderType
  name           String
  credentialsEnc String
  isActive       Boolean          @default(true)
  isDefault      Boolean          @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceTokens DeviceToken[]
  deliveries   NotificationDelivery[]

  @@index([organizationId, isActive])
  @@map("push_providers")
}

model NotificationTemplate {
  id             String              @id @default(uuid())
  /// Null = platform-wide template (e.g. the password-reset email
  /// Module 002 could migrate onto this system later — not done this
  /// phase, see the doc's Integration Points section).
  organizationId String?
  categoryId     String?
  key            String
  name           String
  description    String?
  channel        NotificationChannel
  format         TemplateFormat      @default(HTML)
  subjectTemplate String?
  bodyTemplate   String
  /// Self-relation: a template can reference a reusable layout (e.g. a
  /// branded HTML email shell) that wraps its own bodyTemplate content —
  /// "Reusable layouts" from the spec's Template Engine section.
  layoutId       String?
  locale         String              @default("en")
  version        Int                 @default(1)
  isActive       Boolean             @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     NotificationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  layout       NotificationTemplate? @relation("TemplateLayout", fields: [layoutId], references: [id], onDelete: SetNull)
  layoutUsers  NotificationTemplate[] @relation("TemplateLayout")
  notifications Notification[]
  schedules    NotificationSchedule[]

  @@unique([organizationId, key, locale])
  @@index([organizationId, channel, isActive])
  @@map("notification_templates")
}

// ─────────────────────────────────────────────────────────────────────────
// Core Notification
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id                 String               @id @default(uuid())
  organizationId     String
  type               NotificationType     @default(DIRECT)
  channel            NotificationChannel
  priority           NotificationPriority @default(NORMAL)
  status             NotificationStatus   @default(PENDING)
  categoryId         String?
  templateId         String?
  /// Populated for DIRECT notifications. Null for BROADCAST/ROLE/
  /// PERMISSION/TOPIC, whose actual recipients are resolved at send time
  /// (Phase 2's NotificationService) and tracked per-recipient via
  /// NotificationDelivery rows, not duplicated here.
  recipientUserId    String?
  /// Populated only when type = ROLE.
  recipientRole      OrganizationRole?
  /// Populated only when type = PERMISSION (a platform permission key,
  /// e.g. "billing.admin.manage" — Module 002's Permission.key).
  recipientPermission String?
  /// Populated only when type = TOPIC — an arbitrary subscription topic
  /// string, not backed by its own table this phase (see the doc's
  /// deferred-scope section on pub/sub topic management).
  topic              String?
  subject            String?
  body               String
  /// Rendered template variables / arbitrary payload data, e.g. for
  /// in-app notifications that carry structured data a frontend renders
  /// beyond the plain body text.
  data               Json                 @default("{}")
  locale             String               @default("en")
  scheduledFor       DateTime?
  sentAt             DateTime?
  readAt             DateTime?
  archivedAt         DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     NotificationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient    User?                 @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  deliveries  NotificationDelivery[]
  queueJobs   NotificationQueue[]
  events      NotificationEvent[]
  logs        NotificationLog[]
  attachments NotificationAttachment[]

  @@index([organizationId, status])
  @@index([recipientUserId, status])
  @@index([organizationId, scheduledFor])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationAttachment {
  id             String   @id @default(uuid())
  notificationId String
  fileName       String
  mimeType       String
  sizeBytes      Int
  /// Object-storage reference (e.g. an S3 key), not the file content
  /// itself — this schema doesn't own file storage.
  storageKey     String
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_attachments")
}

// ─────────────────────────────────────────────────────────────────────────
// Delivery, Events, Logs
// ─────────────────────────────────────────────────────────────────────────

model NotificationDelivery {
  id                String         @id @default(uuid())
  notificationId    String
  channel           NotificationChannel
  emailProviderId   String?
  smsProviderId     String?
  pushProviderId    String?
  status            DeliveryStatus @default(PENDING)
  /// The provider's own message/delivery id — needed to correlate inbound
  /// webhook callbacks (bounce/open/click events) back to this row.
  providerMessageId String?
  attempts          Int            @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  failureReason     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  notification  Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  emailProvider EmailProvider? @relation(fields: [emailProviderId], references: [id], onDelete: SetNull)
  smsProvider   SmsProvider?   @relation(fields: [smsProviderId], references: [id], onDelete: SetNull)
  pushProvider  PushProvider?  @relation(fields: [pushProviderId], references: [id], onDelete: SetNull)
  events        NotificationEvent[]

  @@index([notificationId])
  @@index([providerMessageId])
  @@index([status])
  @@map("notification_deliveries")
}

model NotificationEvent {
  id             String    @id @default(uuid())
  notificationId String
  deliveryId     String?
  /// e.g. "sent", "delivered", "opened", "clicked", "bounced",
  /// "complained", "failed" — string, not an enum, since provider webhook
  /// payloads (Section on Delivery Tracking) will introduce event
  /// subtypes this schema shouldn't need a migration to accommodate,
  /// mirroring Module 004's UsageRecord.metric design choice.
  eventType      String
  metadata       Json      @default("{}")
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  notification Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  delivery     NotificationDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([notificationId, eventType])
  @@index([occurredAt])
  @@map("notification_events")
}

/// Domain-specific operational log for notification-system actions
/// (template changes, provider credential rotation, manual resends, etc.)
/// — distinct from Module 002's platform-wide AuditLog, same reasoning as
/// Module 003's OrganizationMembershipEvent: different query patterns,
/// different consumer (an ops/admin notifications dashboard vs. a
/// compliance audit trail).
model NotificationLog {
  id             String   @id @default(uuid())
  organizationId String
  notificationId String?
  action         String
  actorId        String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("NotificationLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([notificationId])
  @@map("notification_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Queue, Scheduling, Digest
// ─────────────────────────────────────────────────────────────────────────

/// Durable record of a queued send job — distinct from Module 001's
/// BullMQ/Redis queue runtime itself. BullMQ owns fast in-flight job
/// state; this table is the durable, queryable audit trail an admin
/// dashboard needs ("show me every failed job in the SMS queue this
/// week") that a Redis-backed queue alone doesn't retain once a job
/// completes or expires. Phase 2's QueueService is responsible for
/// keeping the two in sync (create a row when enqueueing to BullMQ,
/// update status as BullMQ reports progress) — not a replacement for
/// BullMQ, a companion to it.
model NotificationQueue {
  id             String      @id @default(uuid())
  notificationId String
  queueName      String
  status         QueueStatus @default(PENDING)
  priority       NotificationPriority @default(NORMAL)
  scheduledFor   DateTime?
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([queueName, status])
  @@index([status, scheduledFor])
  @@map("notification_queue")
}

model NotificationSchedule {
  id             String            @id @default(uuid())
  organizationId String
  templateId     String
  frequency      ScheduleFrequency
  cronExpression String?
  nextRunAt      DateTime
  lastRunAt      DateTime?
  isActive       Boolean           @default(true)
  /// Mirrors Notification's own recipient-targeting shape (type +
  /// role/permission/topic), kept as JSON here rather than repeating the
  /// same four nullable columns a second time — this row generates
  /// Notification rows, it doesn't need to query by individual target
  /// fields the way Notification itself does.
  targetType     NotificationType
  targetValue    Json              @default("{}")
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive])
  @@index([isActive, nextRunAt])
  @@map("notification_schedules")
}

model NotificationDigest {
  id              String            @id @default(uuid())
  userId          String
  organizationId  String
  frequency       ScheduleFrequency
  /// Category keys this digest aggregates — JSON array rather than a join
  /// table, since a digest's category set is a simple user preference, not
  /// something queried from the category side ("which digests include
  /// category X" has no current use case; if one emerges, this is a
  /// straightforward follow-up migration to a proper join table).
  categoryKeys    Json              @default("[]")
  lastSentAt      DateTime?
  nextScheduledAt DateTime?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, frequency])
  @@index([isActive, nextScheduledAt])
  @@map("notification_digests")
}

// ─────────────────────────────────────────────────────────────────────────
// Preferences, Devices, Outbound Webhooks
// ─────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id              String               @id @default(uuid())
  userId          String
  organizationId  String
  /// Null = applies to all categories (the user's default for this org).
  categoryId      String?
  /// Null = applies to all channels.
  channel         NotificationChannel?
  enabled         Boolean              @default(true)
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String               @default("UTC")
  /// If set, overrides immediate delivery in favor of the user's digest
  /// for this category/channel combination.
  digestFrequency ScheduleFrequency?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     NotificationCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// A user has at most one preference row per (org, category, channel)
  /// combination — category and channel are both nullable "applies to
  /// all" wildcards, so this compound unique has the same nullable-field
  /// caveat as NotificationCategory's key uniqueness above (flagged
  /// there, applies here identically — Phase 2's PreferenceService must
  /// additionally guard against duplicate wildcard rows in application
  /// code).
  @@unique([userId, organizationId, categoryId, channel])
  @@index([userId, organizationId])
  @@map("notification_preferences")
}

model DeviceToken {
  id             String         @id @default(uuid())
  userId         String
  /// Nullable — a device belongs to a user account, not necessarily one
  /// organization (the same phone receives push notifications regardless
  /// of which org context the user is currently viewing).
  organizationId String?
  platform       DevicePlatform
  token          String         @unique
  pushProviderId String?
  isActive       Boolean        @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  pushProvider PushProvider? @relation(fields: [pushProviderId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@map("device_tokens")
}

/// Organization-configured OUTBOUND webhook subscriptions ("notify my
/// system when X happens") — distinct from INBOUND provider callbacks
/// (SendGrid bounce webhooks, Twilio delivery receipts), which arrive at
/// a WebhookController endpoint (Phase 2+) and are verified using each
/// provider's own signature scheme, the same pattern Module 004 already
/// established for payment provider webhooks. This model is the
/// counterpart in the other direction.
model NotificationWebhook {
  id              String    @id @default(uuid())
  organizationId  String
  url             String
  /// HMAC signing secret for outbound payloads — same encrypted-at-rest
  /// discipline as provider credentials above.
  secretEnc       String
  /// Which NotificationEvent.eventType values trigger this webhook.
  eventTypes      Json      @default("[]")
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastStatus      String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("notification_webhooks")
}

// ═════════════════════════════════════════════════════════════════════════
// AI-101 — Market Data Management (Phase 1: schema only)
//
// Design resolutions, flagged rather than silently decided (same
// discipline as every EP module's Phase 1):
//
// 1. AssetClass: modeled as an ENUM, not a table. The prompt lists it in
//    both the model section and explicitly under "Use enums where
//    appropriate, including: AssetClass" — resolved as enum, matching
//    every prior model/enum ambiguity resolution in this project. A
//    classification with no attributes of its own beyond a name doesn't
//    need its own table.
//
// 2. "Source / lineage metadata" is NOT a separate table — it's embedded
//    as consistent fields (provider, receivedAt, importJobId,
//    sourceTimestamp, normalizationVersion) directly on every time-series
//    row (MarketCandle/MarketQuote/MarketTick). A separate lineage table
//    would require a join on every single market-data read, which is the
//    highest-volume query path this entire subsystem exists to serve —
//    a real performance-vs-normalization tradeoff, resolved in favor of
//    embedding for the tables that matter most for read volume.
//
// 3. "ProviderCredentialReference or provider configuration metadata"
//    resolved as ONE model, MarketDataProviderConfig — non-secret
//    configuration (base URL, rate limits, supported asset classes) plus
//    a `credentialReference` string that POINTS to a secret stored
//    elsewhere (a secrets manager path/key), never the secret itself,
//    per the prompt's explicit "do not add real API keys or secrets."
//    This is a genuine deviation from EP-004/EP-005's `credentialsEnc`
//    pattern (encrypted-at-rest, stored here) — deliberate: EP modules
//    own credentials the platform itself uses on the org's behalf,
//    while AI-101's providers are typically PLATFORM-level integrations
//    an operator configures once, and this phase's instruction is
//    explicit that no real secret material belongs in this schema at
//    all, referenced or otherwise stored.
//
// 4. Corrections: MarketCandle is treated as effectively immutable once
//    written — a correction is a NEW row with `isCorrection: true` and
//    `supersedesId` pointing at the row it replaces, never an UPDATE to
//    historical data (the prompt's explicit "never silently overwrite
//    historical corrections"). Readers needing "the current best value"
//    filter for the latest non-superseded row per (instrumentId,
//    interval, eventTime) — a query-layer concern for a future phase,
//    not something this schema enforces structurally (Postgres has no
//    native "latest in a correction chain" constraint).
//
// 5. TENANCY INVERSION FROM EVERY PRIOR EP MODULE (flagged prominently,
//    not buried): every model in this section is deliberately
//    NOT organization-scoped. Modules 002-005 all treated
//    Organization as the tenant boundary (ADR-001); this module inverts
//    that on purpose, per the prompt's explicit instruction — market
//    data is global/product data, not per-tenant data. No
//    organizationId appears anywhere below. Recorded as a new ADR
//    (below the enum/model blocks, mirrored into
//    docs/ARCHITECTURE_DECISIONS.md) specifically because a future
//    engine module's author skimming this schema for the tenancy
//    pattern every other module uses would otherwise reasonably expect
//    an organizationId column that was never supposed to exist here.
// ═════════════════════════════════════════════════════════════════════════

enum AssetClass {
  EQUITY
  ETF
  CRYPTO
  FOREX
  COMMODITY
  INDEX
  BOND
  OPTION
  FUTURE
}

enum InstrumentStatus {
  ACTIVE
  SUSPENDED
  DELISTED
  PENDING
}

enum MarketDataProviderType {
  BINANCE
  POLYGON
  TWELVE_DATA
  ALPHA_VANTAGE
  YAHOO_FINANCE
  TRADINGVIEW_BRIDGE
  BROKER_BRIDGE
  INTERNAL_FEED
}

/// How a given piece of market data reached this system — distinct from
/// WHICH provider (MarketDataProviderType) sent it; a single provider can
/// supply data through more than one of these paths (e.g. Polygon live
/// ticks vs. a Polygon historical backfill import).
enum MarketDataSource {
  LIVE
  DELAYED
  HISTORICAL_IMPORT
  BACKFILL
  MANUAL_CORRECTION
}

enum CandleInterval {
  ONE_MINUTE
  FIVE_MINUTES
  FIFTEEN_MINUTES
  THIRTY_MINUTES
  ONE_HOUR
  FOUR_HOURS
  ONE_DAY
  ONE_WEEK
  ONE_MONTH
}

enum DataQualityStatus {
  CLEAN
  FLAGGED
  UNDER_REVIEW
  CORRECTED
  IGNORED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

enum DataGapStatus {
  DETECTED
  BACKFILLING
  RESOLVED
  UNRESOLVED
  IGNORED
}

enum CorporateActionType {
  SPLIT
  REVERSE_SPLIT
  DIVIDEND
  MERGER
  SPINOFF
  SYMBOL_CHANGE
  DELISTING
}

/// A distinct trading-session kind within one exchange day — most
/// exchanges have at least REGULAR; many also have PRE_MARKET/AFTER_HOURS.
enum TradingSessionType {
  PRE_MARKET
  REGULAR
  AFTER_HOURS
  OVERNIGHT
}

// ─────────────────────────────────────────────────────────────────────────
// Reference / Master Data
// ─────────────────────────────────────────────────────────────────────────

model MarketDataProviderConfig {
  id                     String                 @id @default(uuid())
  type                   MarketDataProviderType
  name                   String
  baseUrl                String?
  /// Points to a secret stored in an external secrets manager (path/key
  /// string) — NEVER the credential itself. See this file's Phase 1
  /// design-resolution comment (Section 3) for why this differs from
  /// EP-004/EP-005's encrypted-at-rest `credentialsEnc` pattern.
  credentialReference    String?
  rateLimitPerMinute     Int?
  supportedAssetClasses  AssetClass[]
  isActive               Boolean                @default(true)
  createdById            String?
  updatedById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  importJobs        DataImportJob[]
  supportedTimeframes SupportedTimeframe[]
  instrumentAliases InstrumentAlias[]
  candles           MarketCandle[]
  quotes            MarketQuote[]
  ticks             MarketTick[]
  corporateActions  CorporateAction[]

  @@index([type, isActive])
  @@map("market_data_provider_configs")
}

model Exchange {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  /// IANA timezone identifier (e.g. "America/New_York") — the prompt's
  /// explicit "store exchange timezone as metadata; never use local
  /// server time as market time." Every session time on this exchange's
  /// TradingSession rows is a local time-of-day interpreted against this
  /// zone, not a fixed UTC offset (handles DST correctly).
  timezone     String
  country      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instruments     Instrument[]
  tradingSessions TradingSession[]

  @@index([isActive])
  @@map("exchanges")
}

model TradingSession {
  id         String             @id @default(uuid())
  exchangeId String
  type       TradingSessionType
  /// Local time-of-day (HH:mm, interpreted against Exchange.timezone),
  /// not a Postgres `time` type — avoids any ambiguity about which
  /// timezone a bare `time` column would otherwise be assumed to mean.
  openTime   String
  closeTime  String
  /// 0 (Sunday) - 6 (Saturday); null = applies every trading day. Modeling
  /// day-of-week variation as a single nullable int rather than a
  /// separate calendar/holiday table is confirmed sufficient through
  /// Phase 2 (approved decision, see docs/rmsm-ai's Phase 2 plan and
  /// ARCHITECTURE_DECISIONS.md ADR-023). Future TradingHoliday/
  /// TradingCalendar/SpecialTradingDay models are each additive — a new
  /// model with its own FK to Exchange (and optionally a reference to
  /// which TradingSession row a special day adjusts) — and require zero
  /// changes to this model when added; verified, not just assumed.
  dayOfWeek  Int?
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId, type, isActive])
  @@map("trading_sessions")
}

/// Per-provider declaration of which candle intervals that provider
/// actually supports — not every provider offers every CandleInterval
/// (e.g. a crypto exchange might not offer ONE_MONTH candles directly).
model SupportedTimeframe {
  id         String          @id @default(uuid())
  providerId String
  interval   CandleInterval
  isEnabled  Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  provider MarketDataProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, interval])
  @@map("supported_timeframes")
}

model Instrument {
  id           String            @id @default(uuid())
  exchangeId   String
  /// The ticker/symbol as canonically known on this exchange (e.g.
  /// "AAPL") — provider-specific variants of this same instrument's
  /// symbol live on InstrumentAlias, not here.
  symbol       String
  name         String
  assetClass   AssetClass
  status       InstrumentStatus  @default(ACTIVE)
  currency     String
  /// International identifiers, both optional — not every instrument
  /// (especially crypto pairs) has either.
  isin         String?
  cusip        String?
  /// Smallest meaningful price increment, as a Decimal (never float —
  /// the prompt's explicit financial-precision requirement) — e.g.
  /// 0.01 for most equities, much smaller for some crypto pairs.
  tickSize     Decimal?         @db.Decimal(20, 10)
  lotSize      Decimal?         @db.Decimal(20, 10)
  listedAt     DateTime?
  delistedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  exchange   Exchange            @relation(fields: [exchangeId], references: [id], onDelete: Restrict)
  aliases    InstrumentAlias[]
  candles    MarketCandle[]
  quotes     MarketQuote[]
  ticks      MarketTick[]
  corporateActions CorporateAction[]
  dataQualityIssues DataQualityIssue[]
  dataGaps   DataGap[]

  @@unique([exchangeId, symbol])
  @@index([assetClass, status])
  @@index([status])
  @@map("instruments")
}

/// A provider's own symbol/code for an instrument this system already
/// knows about under its canonical (exchangeId, symbol) — e.g. Binance
/// might call an instrument "BTCUSDT" while another provider or this
/// system's own canonical symbol is "BTC-USD". Ingestion normalizes
/// through this table before writing any MarketCandle/MarketQuote/
/// MarketTick row, which is why those rows only ever reference
/// `instrumentId`, never a raw provider symbol string.
model InstrumentAlias {
  id             String   @id @default(uuid())
  instrumentId   String
  providerId     String
  providerSymbol String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  instrument Instrument                @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider   MarketDataProviderConfig  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerSymbol])
  @@index([instrumentId])
  @@map("instrument_aliases")
}

// ─────────────────────────────────────────────────────────────────────────
// Time-Series Market Data
//
// Every model below embeds its own lineage fields (providerId, source,
// receivedAt, importJobId, sourceTimestamp, normalizationVersion) rather
// than joining to a separate lineage table — see this file's Phase 1
// design-resolution comment (Section 2) for why.
// ─────────────────────────────────────────────────────────────────────────

model MarketCandle {
  id                  String            @id @default(uuid())
  instrumentId        String
  interval            CandleInterval
  /// The candle's own timestamp (UTC, always) — when this bar started,
  /// not when this system received it. Distinct from receivedAt per the
  /// prompt's explicit timestamp-separation requirement.
  eventTime           DateTime
  open                Decimal           @db.Decimal(24, 10)
  high                Decimal           @db.Decimal(24, 10)
  low                 Decimal           @db.Decimal(24, 10)
  close               Decimal           @db.Decimal(24, 10)
  volume              Decimal           @db.Decimal(30, 10)

  // Lineage
  providerId          String
  source               MarketDataSource
  /// When THIS system received/wrote the row — distinct from eventTime.
  receivedAt           DateTime          @default(now())
  importJobId          String?
  /// The provider's own reported timestamp for this candle, if it
  /// differs from the normalized eventTime (e.g. before timezone
  /// normalization) — kept for audit/debugging, not used in queries.
  sourceTimestamp       DateTime?
  /// Increments whenever this row's normalization logic changes in a way
  /// that could alter historical values (e.g. a timezone-handling bugfix)
  /// — lets a future backfill identify "every candle normalized before
  /// the fix" without re-deriving that from code history.
  normalizationVersion  Int               @default(1)

  // Corrections — see this file's Phase 1 design-resolution comment
  // (Section 4): corrections are new rows, never in-place updates.
  isCorrection  Boolean        @default(false)
  supersedesId  String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrument  Instrument                @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider    MarketDataProviderConfig  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  importJob   DataImportJob?            @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  supersedes  MarketCandle?             @relation("CandleCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy MarketCandle?            @relation("CandleCorrection")

  /// The prompt's explicit idempotency requirement: "prevent duplicate
  /// candles by an appropriate unique constraint, such as instrument,
  /// timeframe, event time and source." Source is included deliberately
  /// — the same (instrument, interval, eventTime) legitimately has both
  /// a LIVE row and a later HISTORICAL_IMPORT row without that being a
  /// duplicate (the import is expected to confirm/reconcile live data,
  /// not collide with it); true duplicate detection (Section: Data
  /// Quality) is a service-layer concern for a later phase, not
  /// something this constraint alone fully solves.
  @@unique([instrumentId, interval, eventTime, source])
  @@index([instrumentId, interval, eventTime])
  @@index([importJobId])
  @@index([providerId])
  @@map("market_candles")
}

model MarketQuote {
  id           String            @id @default(uuid())
  instrumentId String
  bidPrice     Decimal?          @db.Decimal(24, 10)
  askPrice     Decimal?          @db.Decimal(24, 10)
  lastPrice    Decimal?          @db.Decimal(24, 10)
  bidSize      Decimal?          @db.Decimal(30, 10)
  askSize      Decimal?          @db.Decimal(30, 10)
  eventTime    DateTime

  providerId           String
  source               MarketDataSource
  receivedAt           DateTime          @default(now())
  sourceTimestamp      DateTime?

  createdAt DateTime @default(now())

  instrument Instrument               @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider   MarketDataProviderConfig @relation(fields: [providerId], references: [id], onDelete: Restrict)

  /// "Quote freshness" queries (the prompt's explicit index requirement)
  /// — find the latest quote for an instrument fast, without scanning
  /// every historical quote row.
  @@index([instrumentId, eventTime])
  @@index([providerId])
  @@map("market_quotes")
}

model MarketTick {
  id           String            @id @default(uuid())
  instrumentId String
  price        Decimal           @db.Decimal(24, 10)
  size         Decimal           @db.Decimal(30, 10)
  eventTime    DateTime

  providerId      String
  source          MarketDataSource
  receivedAt      DateTime          @default(now())
  sourceTimestamp DateTime?

  createdAt DateTime @default(now())

  instrument Instrument               @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider   MarketDataProviderConfig @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([instrumentId, eventTime])
  @@index([providerId])
  @@map("market_ticks")
}

model CorporateAction {
  id            String              @id @default(uuid())
  instrumentId  String
  type          CorporateActionType
  /// The date this action takes effect for price/quantity adjustment
  /// purposes — distinct from announcedAt (when it was first reported).
  effectiveDate DateTime
  /// Split/reverse-split ratio (e.g. 2.0 for a 2-for-1 split) or
  /// dividend amount per share, depending on `type` — one Decimal field
  /// covers both since a single CorporateAction row is always exactly
  /// one type; a future phase's adjustment-calculation service
  /// interprets this field's meaning based on `type`, not this schema.
  value         Decimal             @db.Decimal(20, 10)
  announcedAt   DateTime?

  providerId String
  source     MarketDataSource
  receivedAt DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrument Instrument               @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider   MarketDataProviderConfig @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([instrumentId, effectiveDate])
  @@map("corporate_actions")
}

// ─────────────────────────────────────────────────────────────────────────
// Operational — Import Tracking & Data Quality
// ─────────────────────────────────────────────────────────────────────────

model DataImportJob {
  id                  String           @id @default(uuid())
  providerId          String
  /// Free-form job classification (e.g. "historical_backfill",
  /// "daily_candle_sync", "corporate_action_sync") — string, not an enum,
  /// since the exact set of job types is a Phase 2+ synchronization-
  /// design decision this schema shouldn't need a migration to
  /// accommodate, mirroring the same NotificationEvent.eventType /
  /// UsageRecord.metric precedent from EP-004/EP-005.
  jobType             String
  status              ImportJobStatus  @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  recordsProcessed    Int              @default(0)
  recordsFailed       Int              @default(0)
  errorSummary        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  provider          MarketDataProviderConfig @relation(fields: [providerId], references: [id], onDelete: Restrict)
  candles           MarketCandle[]
  dataQualityIssues DataQualityIssue[]

  @@index([providerId, status])
  @@index([status])
  @@map("data_import_jobs")
}

model DataQualityIssue {
  id            String             @id @default(uuid())
  instrumentId  String?
  importJobId   String?
  /// Free-form classification (e.g. "duplicate_candle", "out_of_order",
  /// "invalid_price", "stale_quote", "session_mismatch") — string, not an
  /// enum, for the same reason as DataImportJob.jobType: the exact
  /// taxonomy is a Phase 2+ data-quality-service design decision.
  issueType     String
  status        DataQualityStatus @default(FLAGGED)
  severity      String             @default("medium")
  description   String
  detectedAt    DateTime           @default(now())
  resolvedAt    DateTime?

  instrument Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  importJob  DataImportJob?  @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([status, detectedAt])
  @@index([instrumentId, status])
  @@map("data_quality_issues")
}

model DataGap {
  id           String        @id @default(uuid())
  instrumentId String
  interval     CandleInterval
  gapStart     DateTime
  gapEnd       DateTime
  status       DataGapStatus @default(DETECTED)
  detectedAt   DateTime      @default(now())
  backfilledAt DateTime?

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, interval, status])
  @@index([status])
  @@map("data_gaps")
}

// ─────────────────────────────────────────────────────────────────────────
// AI-103 — Strategy Engine (Milestone 2: persistence layer)
//
// Design notes:
// - Every table carries organizationId directly, even tables always
//   reachable via a parent's own organizationId (Rule, Condition,
//   StrategyParameter, ...) — denormalized on purpose, per this
//   milestone's own explicit requirement, so org-scoped queries never
//   need a deep join chain just to filter by tenant.
// - Genuine reversal of AI-101/AI-102's own "no organizationId" design:
//   a user-authored strategy is private, org-owned business data, the
//   same kind as EP-003's own entities — not global product data.
// - `version` (Int, optimistic concurrency) sits alongside `updatedAt`
//   on every mutable table per this milestone's own explicit
//   requirement — a real optimistic-lock column a repository's own
//   `save()` increments and checks, not decorative.
// - RuleGroup is a self-referencing tree (parentGroupId) carrying
//   `treeRole` (ENTRY/EXIT) only on its own root nodes — the entry and
//   exit rule trees named in the domain model's own StrategyVersion
//   aggregate comment, both living in the same table rather than two
//   near-identical ones.
// - Condition.leftOperand/rightOperand are JSON — the domain's own
//   `Operand` discriminated union (indicator reference vs. raw market
//   field vs. constant) has genuinely different shapes per variant;
//   modeling each variant as its own nullable-column set or as 3
//   separate operand tables would multiply real complexity for a
//   value that's read as one unit and never queried by its own
//   sub-fields directly.
// - StrategyCategory is a small reference/lookup table for DISPLAY
//   metadata only (name, description, sort order) — the actual set of
//   valid categories remains the domain's own closed `StrategyCategory`
//   string union; this table doesn't let anyone add a 10th category
//   without also updating that union, since Strategy.categoryCode is
//   still constrained by the StrategyCategoryCode enum below, not by
//   which rows exist in this table.
// ─────────────────────────────────────────────────────────────────────────

enum StrategyStatus {
  ACTIVE
  ARCHIVED
}

enum StrategyVersionStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  SUPERSEDED
}

enum StrategyCategoryCode {
  TREND_FOLLOWING
  MEAN_REVERSION
  MOMENTUM
  BREAKOUT
  SCALPING
  SWING
  ARBITRAGE
  MARKET_MAKING
  CUSTOM
}

enum RuleTreeRole {
  ENTRY
  EXIT
}

enum LogicalOperatorType {
  AND
  OR
  NOT
}

enum ComparisonOperatorType {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  EQUAL
  NOT_EQUAL
  CROSSES_ABOVE
  CROSSES_BELOW
  BETWEEN
}

enum StrategyParameterType {
  INTEGER
  DECIMAL
  BOOLEAN
  ENUM
  STRING
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum StrategyHistoryActionType {
  STRATEGY_CREATED
  VERSION_DRAFTED
  VERSION_VALIDATED
  VERSION_APPROVAL_REQUESTED
  VERSION_APPROVED
  VERSION_REJECTED
  VERSION_PUBLISHED
  STRATEGY_ARCHIVED
}

/// Display metadata for the domain's own closed StrategyCategory set —
/// seeded once (see seed.ts), never created dynamically. See this
/// section's own header comment for why Strategy.categoryCode is still
/// enum-constrained independent of this table's rows.
model StrategyCategory {
  code        StrategyCategoryCode @id
  displayName String
  description String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  strategies Strategy[]

  @@map("strategy_categories")
}

/// A dynamic, author-defined tag dictionary — genuinely open, unlike
/// StrategyCategory above. One row per distinct tag TEXT ever used,
/// shared across the whole platform (not per-organization) since a tag
/// like "backtested-2026" has no organization-specific meaning of its
/// own; StrategyTagAssignment (below) is where organization scoping
/// actually lives, via the Strategy it's assigned to.
model StrategyTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assignments StrategyTagAssignment[]

  @@map("strategy_tags")
}

/// The real junction table this milestone's own "create junction
/// tables where appropriate" asks for.
model StrategyTagAssignment {
  strategyId String
  tagId      String
  assignedAt DateTime @default(now())

  strategy Strategy    @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tag      StrategyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([strategyId, tagId])
  @@index([tagId])
  @@map("strategy_tag_assignments")
}

model Strategy {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String
  categoryCode   StrategyCategoryCode
  status         StrategyStatus       @default(ACTIVE)
  /// Nullable — a brand-new Strategy has no published version yet.
  /// Deliberately a separate FK from StrategyVersion.strategyId (below)
  /// rather than "the version with the highest versionNumber" computed
  /// on read — publication is a real event (StrategyPublication,
  /// below), not simply "the latest one."
  currentPublishedVersionId String? @unique
  version                   Int     @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                StrategyCategory  @relation(fields: [categoryCode], references: [code])
  createdBy               User?             @relation("StrategyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?             @relation("StrategyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  currentPublishedVersion StrategyVersion?  @relation("StrategyCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  versions                StrategyVersion[] @relation("StrategyToVersions")
  tagAssignments          StrategyTagAssignment[]
  historyEntries          StrategyHistory[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, categoryCode])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, name])
  @@map("strategies")
}

model StrategyVersion {
  id             String                 @id @default(uuid())
  organizationId String
  strategyId     String
  versionNumber  Int
  status         StrategyVersionStatus  @default(DRAFT)
  version        Int                    @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategy     Strategy     @relation("StrategyToVersions", fields: [strategyId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("StrategyVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("StrategyVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  currentlyPublishedFor  Strategy?             @relation("StrategyCurrentPublishedVersion")
  ruleGroups             RuleGroup[]
  parameters             StrategyParameter[]
  executionProfiles      ExecutionProfile[]
  validations            StrategyValidation[]
  approvals              StrategyApproval[]
  publications           StrategyPublication[] @relation("PublicationForVersion")
  supersededPublications StrategyPublication[] @relation("PublicationSupersedes")

  @@unique([strategyId, versionNumber])
  @@index([organizationId, status])
  @@index([strategyId, status])
  @@index([organizationId, createdAt])
  @@map("strategy_versions")
}

/// Self-referencing tree. `treeRole` is set only on root nodes
/// (parentGroupId null) — see this section's own header comment.
model RuleGroup {
  id                String              @id @default(uuid())
  organizationId    String
  strategyVersionId String
  parentGroupId     String?
  treeRole          RuleTreeRole?
  operator          LogicalOperatorType
  sortOrder         Int                 @default(0)
  version           Int                 @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  parentGroup     RuleGroup?      @relation("RuleGroupToChildren", fields: [parentGroupId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("RuleGroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?           @relation("RuleGroupUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  childGroups RuleGroup[] @relation("RuleGroupToChildren")
  rules       Rule[]

  @@index([strategyVersionId, parentGroupId])
  @@index([organizationId])
  @@map("rule_groups")
}

model Rule {
  id             String  @id @default(uuid())
  organizationId String
  ruleGroupId    String
  label          String
  enabled        Boolean @default(true)
  sortOrder      Int     @default(0)
  version        Int     @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleGroup    RuleGroup    @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("RuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  condition    Condition?

  @@index([ruleGroupId])
  @@index([organizationId])
  @@map("rules")
}

/// leftOperand/rightOperand/rightOperandUpper are JSON — see this
/// section's own header comment for why.
model Condition {
  id                String                 @id @default(uuid())
  organizationId    String
  ruleId            String                 @unique
  leftOperand       Json
  operator          ComparisonOperatorType
  rightOperand      Json
  /// Populated iff operator = BETWEEN — the domain's own Condition
  /// entity comment explains why this is a plain optional field rather
  /// than a per-operator discriminated type.
  rightOperandUpper Json?
  version           Int                    @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         Rule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ConditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("ConditionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("conditions")
}

/// One row per StrategyParameterDefinition (the domain's own 5-variant
/// discriminated union) — defaultValue/min/max stored as text and
/// interpreted per `type` by the mapper, the same "flexible value as
/// text, typed interpretation at the mapping boundary" approach this
/// platform's own Decimal-precision fields have used since AI-101.
model StrategyParameter {
  id                String                @id @default(uuid())
  organizationId    String
  strategyVersionId String
  name              String
  type              StrategyParameterType
  required          Boolean               @default(false)
  defaultValueText  String?
  minText           String?
  maxText           String?
  /// string[] — only meaningful when type = ENUM.
  allowedValues     Json?
  maxLength         Int?
  sortOrder         Int                   @default(0)
  version           Int                   @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("StrategyParameterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?           @relation("StrategyParameterUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([strategyVersionId, name])
  @@index([organizationId])
  @@map("strategy_parameters")
}

model ExecutionProfile {
  id                String   @id @default(uuid())
  organizationId    String
  strategyVersionId String
  name              String
  parameters        Json     @default("{}")
  version           Int      @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("ExecutionProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?           @relation("ExecutionProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([strategyVersionId, name])
  @@index([organizationId])
  @@map("execution_profiles")
}

model StrategyValidation {
  id                String   @id @default(uuid())
  organizationId    String
  strategyVersionId String
  ranAt             DateTime @default(now())
  passed            Boolean
  findings          Json     @default("[]")

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("StrategyValidationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([strategyVersionId, ranAt])
  @@index([organizationId])
  @@map("strategy_validations")
}

model StrategyApproval {
  id                String           @id @default(uuid())
  organizationId    String
  strategyVersionId String
  requestedByUserId String
  requestedAt       DateTime         @default(now())
  decision          ApprovalDecision @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?
  comments          String?
  version           Int              @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  requestedBy     User            @relation("StrategyApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  decidedBy       User?           @relation("StrategyApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([strategyVersionId, decision])
  @@index([organizationId, decision])
  @@map("strategy_approvals")
}

model StrategyPublication {
  id                  String   @id @default(uuid())
  organizationId      String
  strategyVersionId   String
  publishedByUserId   String
  publishedAt         DateTime @default(now())
  /// Lineage — which prior version this publication replaced. Null for
  /// a strategy's very first publication.
  supersedesVersionId String?

  createdAt DateTime @default(now())

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategyVersion   StrategyVersion  @relation("PublicationForVersion", fields: [strategyVersionId], references: [id], onDelete: Cascade)
  supersedesVersion StrategyVersion? @relation("PublicationSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  publishedBy       User             @relation("StrategyPublicationPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Cascade)

  @@index([strategyVersionId])
  @@index([organizationId, publishedAt])
  @@map("strategy_publications")
}

model StrategyHistory {
  id             String                    @id @default(uuid())
  organizationId String
  strategyId     String
  action         StrategyHistoryActionType
  actorId        String?
  occurredAt     DateTime                  @default(now())
  metadata       Json                      @default("{}")

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategy     Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  actor        User?        @relation("StrategyHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([strategyId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("strategy_history")
}
