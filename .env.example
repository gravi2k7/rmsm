# ─────────────────────────────────────────────────────────────────────────
# RMSM Enterprise Platform — environment variables
#
# No .env.example previously existed in this repository. AUTH-004
# (Bootstrap Administrator) is the task that introduced this file, so it
# documents only the variables that task added — BOOTSTRAP_ADMIN_* below.
# The platform's much larger existing env surface (DATABASE_URL, JWT/
# session secrets, SMTP/Resend, Stripe/Razorpay/PayPal, etc. — see
# @rmsm/config's schemas/*.schema.ts for the authoritative list) is
# unchanged by this task and intentionally not re-documented here to
# avoid this file silently drifting out of sync with that package; a
# dedicated task to generate a complete .env.example from
# @rmsm/config's own schemas would be the right way to close that gap.
# ─────────────────────────────────────────────────────────────────────────

# ── AUTH-004: Bootstrap Administrator ──────────────────────────────────
#
# `pnpm --filter @rmsm/database seed` creates the platform's first
# SUPER_ADMIN account from these variables — without one, a fresh
# deployment has zero users and nobody can ever log in. Idempotent: if a
# SUPER_ADMIN already exists, seeding is a no-op regardless of what these
# are set to.
#
# Leave BOTH BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD unset to
# skip bootstrap-admin creation entirely (e.g. for a throwaway/CI
# database that only needs the roles/permissions/plans seed data). If
# either one is set, both are required — seeding aborts with a clear
# validation error otherwise.
#
# NEVER commit real values here. NEVER commit default/production
# credentials to any .env file.

# The bootstrap administrator's login email. Required if
# BOOTSTRAP_ADMIN_PASSWORD is set.
BOOTSTRAP_ADMIN_EMAIL=

# The bootstrap administrator's password. Required if
# BOOTSTRAP_ADMIN_EMAIL is set. Must satisfy the platform's password
# policy (12+ characters, upper/lowercase, a number, a symbol) — the
# same policy Authentication enforces on every account. Hashed with the
# exact same Argon2id implementation Authentication uses; never logged
# or printed anywhere, including by the seed script itself.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Defaults to "System" if unset.
BOOTSTRAP_ADMIN_FIRST_NAME=

# Optional. Defaults to "Administrator" if unset.
BOOTSTRAP_ADMIN_LAST_NAME=

# Optional. If set, an Organization with this name is created and the
# bootstrap administrator becomes its OWNER, in addition to holding the
# platform-wide SUPER_ADMIN role. If unset, no organization is created —
# the account still has full platform SUPER_ADMIN access.
BOOTSTRAP_ADMIN_ORGANIZATION=
