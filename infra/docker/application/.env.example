# ==========================================
# RMSM Application Stack
# ==========================================

# Environment
NODE_ENV=production
APP_ENV=production

# Images
API_IMAGE=rmsm-api
WEB_IMAGE=rmsm-web
ADMIN_IMAGE=rmsm-admin
AI_IMAGE=rmsm-ai
WORKER_IMAGE=rmsm-worker

# Ports
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
AI_PORT=8000

# Timezone
TZ=Asia/Kolkata

# Database
POSTGRES_HOST=rmsm-postgres
POSTGRES_PORT=5432
POSTGRES_DB=rmsm
POSTGRES_USER=rmsm
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=rmsm-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME